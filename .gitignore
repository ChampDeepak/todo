# Secrets — never commit. M6/M7 are graded on this.
.env
*.env
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
*.log

# Terraform — state files contain resource IDs and sometimes secrets in plain text
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl is deliberately NOT ignored: committing it pins provider
# hashes so CI resolves the identical provider build as your laptop.

# Editor / OS
.DS_Store
.idea/
.vscode/
.kubeconfig-taskr
# large working video files (final m10-demo.mov is committed deliberately)
m10-demo-combined.mov
m10-demo-combined-noNotes.mov
